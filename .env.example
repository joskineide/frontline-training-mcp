# Local development only. Copy to .env (gitignored) and change the password.
POSTGRES_USER=ftm
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ftm
DATABASE_URL=postgresql://ftm:change-me-local-only@127.0.0.1:55432/ftm

# Dev mode enables the fake seed data and the dev-only stand-ins for login (DEV_USER below,
# and the platform stand-in's header): any local process can then act as any user.
# Anything else counts as production.
APP_ENV=dev

# Who the server acts as until login exists (dev only): <tenant>/<user>.
DEV_USER=acme/ana.souza
